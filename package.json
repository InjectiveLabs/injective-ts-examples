{
  "name": "injective-ts-examples",
  "version": "0.0.1",
  "private": true,
  "description": "TypeScript examples for verifying Injective SDK behavior and endpoint responses.",
  "author": "Bojan Angjelkoski <bojan@injectivelabs.org>",
  "repository": "https://github.com/InjectiveLabs/injective-ts-examples",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.7.0",
  "keywords": [
    "typescript"
  ],
  "scripts": {
    "example": "tsx src/runner.ts",
    "example:list": "tsx src/runner.ts list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "postinstall": "pnpm deps:injective:update",
    "deps:injective:update": "pnpm update \"@injectivelabs/*\" --latest"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "^0.31.0",
    "@cosmjs/stargate": "^0.31.0",
    "@cosmjs/tendermint-rpc": "^0.32.4",
    "@injectivelabs/core-proto-ts": "1.16.6",
    "@injectivelabs/exceptions": "1.20.11",
    "@injectivelabs/networks": "1.20.11",
    "@injectivelabs/sdk-ts": "1.20.11",
    "@injectivelabs/ts-types": "1.20.11",
    "@injectivelabs/utils": "1.20.11",
    "@injectivelabs/wallet-base": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-base",
    "@injectivelabs/wallet-core": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-core",
    "@injectivelabs/wallet-private-key": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-private-key",
    "@injectivelabs/wallet-strategy": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-strategy",
    "dotenv": "^16.0.3",
    "global": "^4.4.0",
    "js-base64": "^3.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "@injectivelabs/wallet-core": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-core",
      "@injectivelabs/wallet-private-key": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-private-key",
      "@injectivelabs/wallet-strategy": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-strategy",
      "@injectivelabs/wallet-base": "link:../../../Library/pnpm/global/5/node_modules/@injectivelabs/wallet-base"
    }
  }
}
